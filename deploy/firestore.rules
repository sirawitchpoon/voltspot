rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGatewayServiceAccount() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && request.auth.token.role == 'gateway';
    }

    // Admins are provisioned via scripts/grant-admin.js, which sets
    // a `role: "admin"` Firebase custom claim. The admin webapp
    // queries network-wide; rules grant read access on every
    // operational collection without weakening per-tenant isolation
    // for non-admins (each clause OR's isAdmin() with the existing
    // owner check, so consumers + partners still see only their own
    // data).
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    match /users/{uid} {
      // Admin can list every user doc for the directory view; an
      // owner still has full read+write on their own doc.
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    match /partners/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    match /stations/{stationId} {
      allow read: if isSignedIn();
      allow write: if isGatewayServiceAccount()
        || (isSignedIn()
            && request.auth.uid == request.resource.data.partnerId);
    }

    match /sessions/{sessionId} {
      // Consumer reads their own sessions; partner reads sessions on
      // stations they own. We denormalise partnerId onto the doc at
      // write time (Gateway sets it from /stations/{id}.partnerId at
      // StartTransaction; demo seeds set it explicitly) so this stays
      // a single-document check instead of a cross-collection join.
      // Admins read everything for the operations console.
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || resource.data.partnerId == request.auth.uid
            || isAdmin());
      allow write: if isGatewayServiceAccount();
    }

    match /connector_status/{key} {
      allow read: if isSignedIn();
      allow write: if isGatewayServiceAccount();
    }
  }
}
