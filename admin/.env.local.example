# Copy this file to .env.local and fill in the values from
# Firebase Console -> Project Settings -> "Your apps" -> Web app -> SDK setup config.
# .env.local is gitignored; safe to commit this template only.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=voltspot-e410c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=voltspot-e410c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App-level branding — single source of the brand string. Mirrors the
# iOS AppConfig.appName invariant: nowhere in admin/**/*.{ts,tsx}
# should the literal "Voltspot" appear except via this var.
NEXT_PUBLIC_APP_NAME=Voltspot
